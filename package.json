{
  "name": "citadels-clone",
  "version": "1.0.0",
  "description": "A web-based clone of the board game Citadels — play hot-seat with friends, against bots, or online with a friend code.",
  "type": "module",
  "private": true,
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test tests/*.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "prettier": "^3.8.1"
  }
}
